{
  "name": "spectrumx",
  "version": "1.0.0",
  "private": true,
  "description": "SpectrumX Technologies — static HTML + Tailwind redesign",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "tailwindcss": "3.4.17"
  }
}
